; neopatch configuration for Touhou 20 ~ Fossilized Wonders (th20.exe v1.00a)
;
; Place this file next to th20.exe and name it "neopatch.ini".
; All keys are optional and will fall back to default values.
; Section names, key names, and values are case-insensitive.
; Comments start with ";" or "#" and cause everything after them
; on the same line to be ignored. Values can be wrapped in
; matching double quotes ("...") or single quotes ('...').
; When using neopatch, the game follows this file instead of th20.cfg.


; Frame/tick rate caps. Higher rates speed everything up.
; 0 completely uncaps the tick rate and makes the game run
; as fast as your CPU and GPU can handle.
[framerate]
; Tick rate in normal gameplay. Default: 60
game_fps = 60

; Tick rate while fast-forwarding through replays (hold Ctrl while watching
; a replay). Default: 240
replay_skip_fps = 240

; Tick rate while slowing down in replays (hold Shift while watching a replay).
; th20 has no built-in replay slow-motion; neopatch adds it. Default: 30
replay_slow_fps = 30


[display]
; Display mode. Default: Windowed
;   Windowed
;   Fullscreen
;   Borderless     - fullscreen-borderless monitor-fill; the resolution key
;                    and most of [window] are ignored.
mode = Windowed

; Game resolution. Default: 1280x960
;   640x480
;   960x720
;   1280x960
resolution = 1280x960

; Fullscreen refresh rate selection. Ignored in windowed mode.
; Default: NativeMultiple
;   Native           - highest supported rate not above the desktop's rate
;                      at the chosen resolution; otherwise the lowest supported rate
;   NativeMultiple   - highest supported multiple-of-60 rate not above the desktop's rate
;                      at the chosen resolution; otherwise identical to Native
;   <integer>        - force a specific rate in Hz; falls back to the game's original rate
;                      if rejected at the chosen resolution
refresh_rate = NativeMultiple


[window]
; Note: under [display] mode = Borderless, the game controls geometry and style,
; so x/y/width/height/frame are ignored, but always_on_top still applies.

; Requested outer window position in screen coordinates.
; When both are unset, the system and window manager selects the position.
; When only one is set, the other defaults to 0. Default: unset
; x = 0
; y = 0

; Client-area size. Default: uses the [display] resolution
; width  = 1280
; height = 960

; Window styling. Default: Borderless for Fullscreen; Frameless for Windowed
;   Framed       - title bar with minimize/maximize/close buttons
;   Frameless    - no caption or border, but minimize/maximize/close still works
;   Borderless   - pure pixel rectangle; no styling
; frame = Frameless

; Whether to keep the game window above all other windows. Default: false
always_on_top = false


[input]
; Treat the controller's D-pad (POV hat) as movement input.
;
; This can be disabled if you already remap controller inputs
; or the analog stick stops responding while the D-pad is held.
; Default: true
dpad = true


[process]
; Process priority class. Default: Unchanged
;   Unchanged
;   Idle
;   BelowNormal
;   Normal
;   AboveNormal
;   High
priority = Unchanged

; CPU affinity bitmask, one bit per logical core.
; Useful on hybrid Intel CPUs for making the game run on P-cores over E-cores.
; Accepts decimal, hex (0x), octal (0o), or binary (0b).
; Default: 0 (no affinity specified)
; affinity_mask = 0xFF


; Each session writes log data to the directory <log_dir>/<session_id>/.
[log]
; Log verbosity. Each level includes all higher-priority levels. Default: info
;   off
;   error
;   warn
;   info
;   debug
;   trace
level = info

; Total number of sessions to keep logs for, including the new session.
; Older ones are deleted at startup.
; Default: 10
sessions_to_keep = 10

; The log root directory. Quote the path if it contains spaces.
; Default behavior: try writing to <install_dir>\neopatch_logs\ first,
; then %LOCALAPPDATA%\neopatch_logs\, then %TEMP%\neopatch_logs\.
; log_dir = "C:\Users\me\neopatch_logs"
